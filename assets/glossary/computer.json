  "definitions": {
    "指针": "存储另一个变量内存地址的变量，C/C++ 中通过 * 解引用",
    "野指针": "指向已释放或未初始化内存的指针，使用会导致未定义行为",
    "递归": "函数直接或间接调用自身，需有终止条件",
    "时间复杂度": "算法执行时间随输入规模增长的趋势，用大O表示",
    "哈希表": "通过哈希函数把键映射到桶的数组，平均查找 O(1)",
    "二叉树": "每个节点最多两个子节点的树结构",
    "二叉搜索树": "左子树小于根、右子树大于根的二叉树，查找 O(log n)",
    "平衡二叉树": "左右子树高度差不超过1的二叉搜索树，保证 O(log n)",
    "红黑树": "通过颜色约束保持近似平衡的二叉搜索树",
    "动态规划": "把问题分解为重叠子问题并保存中间结果，避免重复计算",
    "贪心算法": "每步选局部最优，期望得到全局最优（不总成立）",
    "死锁": "多个进程互相等待对方持有的资源而无法推进",
    "虚拟内存": "为每个进程提供独立地址空间的抽象，通过页表映射到物理内存",
    "三次握手": "TCP 建立连接：SYN → SYN+ACK → ACK",
    "四次挥手": "TCP 关闭连接：FIN → ACK → FIN → ACK",
    "事务": "数据库操作的原子单位，满足 ACID 特性",
    "索引": "加速查询的数据结构（如 B+树），代价是写入变慢和占空间",
    "多态": "同一接口对不同对象产生不同行为，C++ 通过虚函数实现",
    "虚函数": "用 virtual 声明、可在子类重写的成员函数，通过虚表动态派发",
    "析构函数": "对象销毁时自动调用的成员函数，用于释放资源",
    "闭包": "捕获了外部作用域变量的函数对象",
    "协程": "用户态轻量级线程，可在特定点挂起和恢复",
    "垃圾回收": "自动回收不再使用的内存，如 Java/Python 的 GC"
  }
}