  "definitions": {
    "共价键": "原子间共享电子对形成的化学键",
    "离子键": "阴阳离子间通过静电引力形成的化学键",
    "电负性": "原子在化合物中吸引电子的能力",
    "氧化还原": "电子转移的反应，氧化剂得电子、还原剂失电子",
    "摩尔": "物质的量的单位，1 mol 含 6.022×10²³ 个粒子",
    "平衡常数": "K = [产物]/[反应物]（平衡时），反映反应进行的程度",
    "勒夏特列原理": "改变条件时平衡向减弱这种改变的方向移动",
    "吉布斯自由能": "ΔG = ΔH - TΔS，ΔG<0 时反应自发",
    "线粒体": "有氧呼吸的主要场所，含自身DNA",
    "叶绿体": "光合作用的场所，含叶绿素和自身DNA",
    "有丝分裂": "体细胞增殖方式，染色体复制后均分到两个子细胞",
    "减数分裂": "生殖细胞形成方式，染色体数目减半",
    "等位基因": "同一基因座上的不同版本，控制相对性状",
    "转录": "以DNA为模板合成mRNA的过程",
    "翻译": "以mRNA为模板在核糖体上合成蛋白质",
    "密码子": "mRNA上三个相邻碱基，决定一个氨基酸",
    "半保留复制": "DNA复制时每条子链保留一条母链",
    "自然选择": "适应环境的个体留下更多后代，种群基因频率改变",
    "光合作用": "光能转化为化学能，CO₂+H₂O→有机物+O₂",
    "酶": "活细胞产生的生物催化剂，本质多为蛋白质，具有专一性和高效性"
  }
}