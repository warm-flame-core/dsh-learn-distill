  "definitions": {
    "质点": "忽略大小和形状、只保留质量的理想化物体，用于简化运动分析",
    "位移": "物体位置的变化量，是矢量；与路程（标量）不同",
    "角动量": "L = r × p，描述转动状态的守恒量",
    "转动惯量": "I = Σmr²，刚体抵抗角加速度的量，类比平动的质量",
    "简谐振动": "回复力与位移成正比且反向的振动，x = A cos(ωt+φ)",
    "振幅": "振动偏离平衡位置的最大距离",
    "相位": "决定振子在某一时刻运动状态的量 (ωt+φ)",
    "干涉": "两列相干波叠加产生稳定的强弱分布",
    "衍射": "波遇到障碍物或孔隙时绕过传播、偏离直线的现象",
    "电场强度": "E = F/q，单位正电荷在该点受到的电场力",
    "电势": "单位正电荷从该点移到参考点的电场力做功，是标量",
    "磁感应强度": "B，描述磁场强弱和方向，单位特斯拉(T)",
    "磁通量": "Φ = ∫B·dS，穿过某面的磁感线总数",
    "安培力": "通电导线在磁场中受的力，F = BIL sinθ",
    "洛伦兹力": "运动电荷在磁场中受的力，F = qvB sinθ",
    "电磁感应": "磁通量变化产生感应电动势的现象",
    "楞次定律": "感应电流的磁场总要阻碍引起感应电流的磁通量变化",
    "熵": "描述系统无序程度的态函数，ΔS = ∫dQ/T",
    "卡诺循环": "由两个等温和两个绝热过程组成的理想循环，效率 η = 1 - T₂/T₁",
    "光程差": "两束光走过的几何路程与折射率乘积之差，Δ = n₂r₂ - n₁r₁",
    "折射率": "n = c/v，光在真空与介质中速度之比",
    "狭义相对论": "1905年爱因斯坦提出，基于相对性原理和光速不变原理",
    "洛伦兹变换": "不同惯性系之间时空坐标的变换关系",
    "波函数": "ψ，描述量子系统状态的复函数，|ψ|² 为概率密度",
    "薛定谔方程": "描述量子态随时间演化的基本方程 iℏ∂ψ/∂t = Ĥψ",
    "不确定性原理": "Δx·Δp ≥ ℏ/2，位置与动量不能同时精确确定",
    "光电效应": "光照射金属表面逸出电子的现象，证明光的粒子性"
  }
}