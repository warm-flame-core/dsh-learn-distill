  "definitions": {
    "分封制": "周天子把土地分给诸侯，诸侯承担义务的政治制度",
    "宗法制": "以血缘关系为纽带、嫡长子继承为核心的制度",
    "郡县制": "秦朝推行的地方行政制度，中央直接任命郡守县令",
    "科举制": "隋唐起通过考试选拔官员的制度，打破门阀垄断",
    "三省六部制": "隋唐中央官制，中书决策、门下审议、尚书执行",
    "行省制": "元朝创立的地方行政制度，影响后世省制",
    "军机处": "清朝雍正设立的辅政机构，标志君主专制达到顶峰",
    "一条鞭法": "明朝张居正推行，赋役合并、计亩征银",
    "摊丁入亩": "清朝把丁税摊入田赋，废除人头税",
    "自然经济": "自给自足、生产与消费基本在家庭内完成的经济形态",
    "基尼系数": "衡量收入分配不平等程度，0-1，越大越不平等",
    "恩格尔系数": "食品支出占总支出的比例，越低越富裕",
    "机会成本": "为选择某方案而放弃的最大潜在收益",
    "边际效用": "每增加一单位消费带来的额外满足感，通常递减",
    "价值规律": "商品价值由社会必要劳动时间决定，价格围绕价值波动",
    "剩余价值": "马克思理论中工人创造的、被资本家无偿占有的价值",
    "生产力": "人类改造自然的能力，包括劳动者、劳动工具、劳动对象",
    "生产关系": "人们在生产中形成的关系，包括所有制、地位、分配",
    "季风": "随季节改变风向的风，东亚季风最典型",
    "锋面": "冷暖气团交界处，常伴随降水",
    "洋流": "大规模海水定向流动，影响气候和渔场分布",
    "区位优势": "某地发展特定产业的优势条件组合"
  }
